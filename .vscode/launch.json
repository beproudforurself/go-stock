{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Attach to go-stock",
      "type": "go",
      "request": "attach",
      "mode": "local",
      "processId": "${command:pickProcess}"
    },
    {
      "name": "Debug built go-stock.exe",
      "type": "go",
      "request": "launch",
      "mode": "exec",
      "program": "${workspaceFolder}/build/bin/go-stock.exe",
      "cwd": "${workspaceFolder}"
    }
  ]
}